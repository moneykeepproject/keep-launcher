<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.moneykeep.keep-launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>MoneyKeep Launcher</name>
  <summary>Install, update and launch the MoneyKeep Apps</summary>
  <developer id="com.moneykeep">
    <name>MoneyKeep Project</name>
  </developer>
  <description>
    <p>
      MoneyKeep Launcher lists every app in the MoneyKeep Apps (MoneyKeep, CalcKeep, GroupKeep and Form1099Keep: apps for
      financial management), installs the right build for your computer, and keeps them up to date.
    </p>
    <ul>
      <li>One place to find, install and open every MoneyKeep app</li>
      <li>Checks GitHub releases for updates and installs them for you</li>
      <li>Lives in the system tray and tells you when updates are ready</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.moneykeep.keep-launcher.desktop</launchable>
  <icon type="stock">com.moneykeep.keep-launcher</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/moneykeepproject/keep-launcher</url>
  <url type="bugtracker">https://github.com/moneykeepproject/keep-launcher/issues</url>
  <url type="help">https://github.com/moneykeepproject/keep-launcher</url>
  <url type="contact">https://github.com/moneykeepproject/keep-launcher/issues</url>
  <categories>
    <category>Utility</category>
    <category>PackageManager</category>
  </categories>
  <keywords>
    <keyword>launcher</keyword>
    <keyword>installer</keyword>
    <keyword>updater</keyword>
    <keyword>moneykeep</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#d9dce3</color>
    <color type="primary" scheme_preference="dark">#26282e</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>keep-launcher</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
